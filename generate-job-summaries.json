    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\n// Filter to undigested jobs only\nconst jobs = allItems\n  .map(item => item.json)\n  .filter(job => String(job.digested).toUpperCase() !== 'TRUE' && job.job_id);\n\n// Sort newest first\njobs.sort((a, b) => new Date(b.received_at).getTime() - new Date(a.received_at).getTime());\n\n// Build HTML email\nconst rows = jobs.map(job => `\n  <tr>\n    <td style=\"padding:12px;border-bottom:1px solid #eee;\">\n      <strong>\n        <a href=\"${job.job_url}\" style=\"color:#0a66c2;text-decoration:none;\">\n          ${job.job_title}\n        </a>\n      </strong><br>\n      <span style=\"color:#555;\">${job.company}</span><br>\n      <span style=\"color:#777;font-size:13px;\">${job.location}</span><br>\n      <span style=\"color:#999;font-size:12px;\">\n        ${new Date(job.received_at).toLocaleDateString('en-US', { month:'short', day:'numeric' })}\n      </span>\n    </td>\n  </tr>\n`).join('');\n\nconst dateLabel = new Date().toLocaleDateString('en-US', { \n  weekday:'long', month:'long', day:'numeric' \n});\n\nconst html = `<!DOCTYPE html>\n<html>\n<body style=\"font-family:Roboto,sans-serif;max-width:600px;margin:0 auto;color:#333;padding:20px;\">\n  <h2 style=\"color:#0a66c2;border-bottom:2px solid #0a66c2;padding-bottom:8px;\">\n    Job Digest — ${dateLabel}\n  </h2>\n  <p style=\"color:#555;\">${jobs.length} new job${jobs.length !== 1 ? 's' : ''}</p>\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;\">\n    ${rows}\n  </table>\n  <p style=\"color:#999;font-size:12px;margin-top:24px;\">\n    Your daily job alert summary\n  </p>\n</body>\n</html>`;\n\nconst today = new Date().toLocaleDateString('en-US', { month:'short', day:'numeric' });\n\nreturn [{ json: {\n  has_jobs: true,\n  html,\n  subject: `Job Digest — ${today} (${jobs.length} new)`\n}}];\n"
      },
      "type": "n8n-nodes-base.code",
